#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

void display(Node* head) {
    Node* temp = head;

    while (temp != NULL) {
        cout << temp->data << " -> ";
        temp = temp->next;
    }

    cout << "NULL" << endl;
}

void search(Node* head, int value) {
    Node* temp = head;
    int position = 1;

    while (temp != NULL) {
        if (temp->data == value) {
            cout << "Element " << value
                 << " found at position " << position << endl;
            return;
        }

        temp = temp->next;
        position++;
    }

    cout << "Element " << value << " not found." << endl;
}

void insertAtBeginning(Node*& head, int value) {
    Node* newNode = new Node();

    newNode->data = value;
    newNode->next = head;

    head = newNode;
}

int main() {

    Node* head = new Node();
    Node* second = new Node();
    Node* third = new Node();
    Node* fourth = new Node();
    Node* fifth = new Node();

    head->data = 10;
    head->next = second;

    second->data = 20;
    second->next = third;

    third->data = 30;
    third->next = fourth;

    fourth->data = 40;
    fourth->next = fifth;

    fifth->data = 50;
    fifth->next = NULL;

    cout << "Original Linked List:" << endl;
    display(head);

    cout << "\nSearching for element 30:" << endl;
    search(head, 30);

    insertAtBeginning(head, 5);

    cout << "\nUpdated Linked List after inserting 5:" << endl;
    display(head);

    cout << "\nFinal Linked List:" << endl;
    display(head);

    return 0;
}
