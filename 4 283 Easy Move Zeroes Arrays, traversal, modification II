
class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int write = 0;

        for (int read = 0; read < static_cast<int>(nums.size()); read++) {
            if (nums[read] != 0) {
                if (read != write) {
                    swap(nums[read], nums[write]);  // skip needless self-swaps
                }
                write++;
            }
        }
    }
};
